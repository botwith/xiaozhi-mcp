# Docker Registry Configuration
# 复制此文件为 .env 并根据需要修改配置
# cp .env.example .env

# Docker Registry 地址
DOCKER_REGISTRY=crpi-lwoxnalpjm9a03w9.cn-shanghai.personal.cr.aliyuncs.com

# 命名空间
DOCKER_NAMESPACE=oj8k

# 镜像名称
DOCKER_IMAGE_NAME=xiaozhi-mcp

# 构建平台（多架构支持，用逗号分隔）
# 默认：linux/amd64,linux/arm64
# 单架构示例：linux/amd64
DOCKER_PLATFORM=linux/amd64,linux/arm64

# 额外标签（可选，用逗号分隔）
# 支持的值：latest, nightly
# 默认会构建：0.0.yymmdd（日期版本）和 dev
# 示例：DOCKER_EXTRA_TAGS=latest,nightly
# DOCKER_EXTRA_TAGS=latest,nightly
