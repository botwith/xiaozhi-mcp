mcp:
  # WebSocket endpoint URL (can be overridden by MCP_ENDPOINT env var)
  endpoint: ws://localhost:8080/mcp
  
  # Optional: Token for authentication (can be overridden by MCP_TOKEN env var)
  # token: your-token-here
  
  # Common configuration variables (can be referenced using ${mcp.modelscope.api-key:default-value})
  # Example: Define a common API key that can be reused across multiple servers
  modelscope:
    api-key: your-modelscope-api-key-here
  
  # MCP servers configuration
  servers:
    local-stdio-calculator:
      enabled: true
      type: stdio
      command: python
      args:
        - src/mcp/tools/calculator.py
    
    local-stdio-stock:
      enabled: true
      type: stdio
      command: python
      args:
        - src/mcp/tools/stock.py
    
    local-stdio-email:
      enabled: true
      type: stdio
      command: python
      args:
        - src/mcp/tools/email_tool.py
      smtp:
        host: smtp.example.com
        port: 587
        user: your-email@example.com
        password: your-password-here
        from_email: your-email@example.com
        from_name: MCP Email Tool
    
    local-stdio-netease-music:
      enabled: true
      type: stdio
      command: python
      args:
        - src/mcp/tools/netease_music.py
    
    local-stdio-mac-app-launcher:
      enabled: true
      type: stdio
      command: python
      args:
        - src/mcp/tools/mac_app_launcher.py
      comment: Mac应用程序启动器 - 支持打开Chrome、微信、计算器、同花顺、电话、FaceTime等
    
    local-stdio-contacts:
      enabled: true
      type: stdio
      command: python
      args:
        - src/mcp/tools/contacts.py
      comment: 联系人管理MCP - 支持存储和管理联系人信息，包括电话、邮箱、微信ID等，支持场景备注（个人、办公等）
    
    local-stdio-todo:
      enabled: true
      type: stdio
      command: python
      args:
        - src/mcp/tools/todo.py
      comment: 待办事项管理MCP - 支持创建、读取、更新、删除待办事项，以及设置完成/未完成状态
    
    mcp-hotnews-server:
      enabled: false
      type: sse
      url: https://mcp.api-inference.modelscope.net/YOUR_ENDPOINT_ID/sse
      headers:
        Authorization: Bearer ${mcp.modelscope.api-key}
      comment: 热闻MCP服务 - 请将YOUR_ENDPOINT_ID替换为实际的endpoint_id，API key使用公共配置
    
    StockBaseInfoMCP:
      enabled: false
      type: sse
      url: https://mcp.api-inference.modelscope.net/YOUR_ENDPOINT_ID/sse
      headers:
        Authorization: Bearer ${mcp.modelscope.api-key}
      comment: 查询股票基础信息MCP - 请将YOUR_ENDPOINT_ID替换为实际的endpoint_id，API key使用公共配置
    
    edgeone-pages-mcp:
      enabled: false
      type: sse
      url: https://mcp.api-inference.modelscope.net/YOUR_ENDPOINT_ID/sse
      comment: EdgeOne Pages MCP服务 - 请将YOUR_ENDPOINT_ID替换为实际的endpoint_id
    
    mind-map-mcp:
      enabled: false
      type: sse
      url: https://mcp.api-inference.modelscope.net/YOUR_ENDPOINT_ID/sse
      comment: 思维导图MCP服务 - 请将YOUR_ENDPOINT_ID替换为实际的endpoint_id
    
    howtocook-mcp:
      enabled: false
      type: sse
      url: https://mcp.api-inference.modelscope.net/YOUR_ENDPOINT_ID/sse
      comment: 如何做饭MCP服务 - 请将YOUR_ENDPOINT_ID替换为实际的endpoint_id
    
    remote-sse-server:
      enabled: false
      type: sse
      url: https://api.example.com/sse
    
    remote-http-server:
      enabled: false
      type: http
      url: https://api.example.com/mcp
      headers:
        Authorization: Bearer YOUR_API_KEY_HERE
        Content-Type: application/json
    
    remote-http-server-example:
      enabled: false
      type: http
      url: https://your-mcp-server.com/api/mcp
      headers:
        Authorization: Bearer ${mcp.modelscope.api-key:your-api-key-here}
        X-Custom-Header: custom-value
      comment: HTTP远程MCP服务示例 - 启用前请设置正确的URL和认证信息。可以使用 ${mcp.modelscope.api-key:default} 格式引用公共配置，如果配置不存在则使用默认值
