[Unit]
Description=XiaoZhi MCP Server
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/xiaozhi-mcp
Environment=PATH=/home/YOUR_USERNAME/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/YOUR_USERNAME/.local/bin/uv run python src/app.py
Restart=on-failure
RestartSec=10
StandardOutput=append:/path/to/xiaozhi-mcp/app.log
StandardError=append:/path/to/xiaozhi-mcp/app.error.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
